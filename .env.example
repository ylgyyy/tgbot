# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=你的机器人Token

# 管理员 Telegram 用户 ID（数字）
OWNER_ID=你的Telegram用户ID

# 代理地址，直连可留空（如 http://127.0.0.1:7897）
TG_PROXY=

# 时区
TZ=Asia/Shanghai

# 骗子库远程链接（默认已填，可留空使用默认值）
# SCAMMER_URL=https://raw.githubusercontent.com/ylgyyy/tgbot/refs/heads/main/scammers.json

# 骗子库刷新间隔（秒，默认 300）
# REFRESH_INTERVAL=300
